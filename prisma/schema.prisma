generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  // App traffic. On Supabase: the transaction pooler (port 6543, ?pgbouncer=true).
  url       = env("DATABASE_URL")
  // Migrations only. On Supabase: the direct or session connection (port 5432).
  // Locally and on Cloud SQL, set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  nurse
  physician
  admin
}

enum Gender {
  male
  female
}

enum JourneyStatus {
  visual_triage
  awaiting_ctas
  ctas_in_progress
  completed // triaged, waiting to be seen by a physician (stays on the board)
  seen      // seen by a physician (leaves the board)
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole @default(nurse)
  failedLoginCount Int  @default(0) @map("failed_login_count")
  lockedUntil  DateTime? @map("locked_until")
  /// Deactivated staff cannot sign in; their records and history stay.
  active       Boolean  @default(true)
  /// Set when an admin creates the account or resets the password: change it at next sign-in.
  mustChangePassword Boolean @default(false) @map("must_change_password")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  journeys     PatientJourney[] @relation("JourneyCreator")
  triageRecords TriageRecord[]  @relation("TriageCreator")
  auditEvents  AuditEvent[]
  libraryPublishes ClinicalLibraryPublish[]
  routingPublishes RoutingConfigPublish[]
  ctasReviews  CtasReview[]   @relation("CtasReviewer")
  feedbackAcks TriageFeedback[]

  @@map("users")
}

model PatientJourney {
  id        String   @id @default(uuid())
  patientId String   @unique @map("patient_id")
  /// Short public number for the wall display (shown as T + last 3 digits). Never a name.
  ticketNo  Int      @default(autoincrement()) @map("ticket_no")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// PDPL (Oct 2026): no names, national ID, phone, MRN, date of birth, nationality or
  /// insurance here. The HIS Transaction No. (encounterNo) is the only link to the patient.
  age              Int?
  gender           Gender?
  arrivalTime      DateTime @default(now()) @map("arrival_time")
  modeOfArrival    String?  @map("mode_of_arrival")

  vtCompleted          Boolean   @default(false) @map("vt_completed")
  vtCompletedAt        DateTime? @map("vt_completed_at")
  vtDurationSec        Int?      @map("vt_duration_sec")
  vtSectionABreathing  String?   @map("vt_section_a_breathing")
  vtSectionAConsciousness String? @map("vt_section_a_consciousness")
  vtSectionABleeding   String?   @map("vt_section_a_bleeding")
  vtSectionASkin       String?   @map("vt_section_a_skin")
  vtSectionAMobility   String?   @map("vt_section_a_mobility")
  vtRespiratoryScore   Int?      @map("vt_respiratory_score")
  vtRespiratorySymptoms String?  @map("vt_respiratory_symptoms")
  vtMonkeypoxRisk      String?   @map("vt_monkeypox_risk")
  vtDestination        String?   @map("vt_destination")
  vtDestinationAr      String?   @map("vt_destination_ar")
  vtDestinationEn      String?   @map("vt_destination_en")
  vtMaskGiven          Boolean   @default(false) @map("vt_mask_given")
  vtHandHygieneDone    Boolean   @default(false) @map("vt_hand_hygiene_done")
  vtAlertTeamNotified  Boolean   @default(false) @map("vt_alert_team_notified")

  regCompleted    Boolean   @default(false) @map("reg_completed")
  regCompletedAt  DateTime? @map("reg_completed_at")
  regBy           String?   @map("reg_by")
  regDurationSec  Int?      @map("reg_duration_sec")

  ctasStartedAt       DateTime? @map("ctas_started_at")
  ctasCompletedAt     DateTime? @map("ctas_completed_at")
  ctasLevel           Int?      @map("ctas_level")
  chiefComplaint      String?   @map("chief_complaint")
  currentStatus       JourneyStatus @default(visual_triage) @map("current_status")
  currentLocation     String?   @map("current_location")
  ctasReviewedAt      DateTime? @map("ctas_reviewed_at")
  clinicianFinalCtas  Int?      @map("clinician_final_ctas")
  rulesRecommendedCtas Int?     @map("rules_recommended_ctas")
  aiRecommendedCtas   Int?      @map("ai_recommended_ctas")
  alertTriggeredAt    DateTime? @map("alert_triggered_at")
  alertAcknowledgedAt DateTime? @map("alert_acknowledged_at")
  alertAcknowledgedBy String?   @map("alert_acknowledged_by")
  incompleteDataFlags Json?     @map("incomplete_data_flags")
  seenAt              DateTime? @map("seen_at")
  /// HIS encounter number (scanned from the wristband or registration slip). The only
  /// link to the hospital record kept here; names and IDs stay in the HIS.
  encounterNo         String?   @unique @map("encounter_no")
  encounterLinkedAt   DateTime? @map("encounter_linked_at")
  encounterLinkedById String?   @map("encounter_linked_by_id")

  createdBy     User           @relation("JourneyCreator", fields: [createdById], references: [id])
  triageRecords TriageRecord[]
  ctasReviews   CtasReview[]

  @@index([currentStatus, arrivalTime])
  @@index([createdById])
  @@map("patient_journeys")
}

model TriageRecord {
  id        String   @id @default(uuid())
  journeyId String   @map("journey_id")
  createdById String @map("created_by_id")
  createdAt DateTime @default(now()) @map("created_at")

  arrivalTime       DateTime? @map("arrival_time")
  age               Int?
  gender            Gender?
  chiefComplaint    String?   @map("chief_complaint")
  hr                Int?
  bpSystolic        Int?      @map("bp_systolic")
  bpDiastolic       Int?      @map("bp_diastolic")
  spo2              Int?
  rr                Int?
  temperature       Float?
  gcs               Int?
  painScore         Int?      @map("pain_score")
  /// Redacted (no ID/phone numbers or spoken names); deleted after TRANSCRIPT_RETENTION_DAYS.
  transcription     String?
  ctasLevel         Int?      @map("ctas_level")
  ctasNameAr        String?   @map("ctas_name_ar")
  ctasNameEn        String?   @map("ctas_name_en")
  maxWaitTime       String?   @map("max_wait_time")
  clinicalSummaryAr String?   @map("clinical_summary_ar")
  redFlags          Json?     @map("red_flags")
  disposition       String?
  nurseName         String?   @map("nurse_name")
  aiCtas            Int?      @map("ai_ctas")
  nurseCtas         Int?      @map("nurse_ctas")
  agreement         Boolean?
  overrideReason    String?   @map("override_reason")
  flaggedForReview  Boolean   @default(false) @map("flagged_for_review")
  triageDurationMin Int?      @map("triage_duration_min")
  patientId         String?   @map("patient_id")
  rulesRecommendedCtas Int?   @map("rules_recommended_ctas")
  aiRecommendedCtas Int?      @map("ai_recommended_ctas")
  clinicianFinalCtas Int?     @map("clinician_final_ctas")
  clinicianReviewedAt DateTime? @map("clinician_reviewed_at")
  reviewedBy        String?   @map("reviewed_by")
  ctasStartedAt     DateTime? @map("ctas_started_at")
  ctasCompletedAt   DateTime? @map("ctas_completed_at")
  doorToTriageMin   Int?      @map("door_to_triage_min")
  alertTriggered    Boolean   @default(false) @map("alert_triggered")
  alertTriggeredAt  DateTime? @map("alert_triggered_at")
  alertAcknowledgedAt DateTime? @map("alert_acknowledged_at")
  alertResponseSec  Int?      @map("alert_response_sec")
  alertSummary      String?   @map("alert_summary")
  aiConfidence      Float?    @map("ai_confidence")
  safetyNote        String?   @map("safety_note")
  missingFields     Json?     @map("missing_fields")
  assessmentTrail   Json?     @map("assessment_trail_json")
  libraryVersions   Json?     @map("library_versions")
  clinicalSummaryEn String?   @map("clinical_summary_en")
  validatedPayload  Json?     @map("validated_payload")

  journey   PatientJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  createdBy User           @relation("TriageCreator", fields: [createdById], references: [id])

  @@index([journeyId])
  @@index([createdById])
  @@map("triage_records")
}

model ClinicalLibraryPublish {
  id            String   @id @default(uuid())
  version       String
  isActive      Boolean  @default(false) @map("is_active")
  modifiers     Json
  modifiersVersion String @map("modifiers_version")
  redFlags      Json     @map("red_flags")
  changelog     String?
  publishedAt   DateTime @default(now()) @map("published_at")
  publishedById String   @map("published_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  publishedBy User @relation(fields: [publishedById], references: [id])

  @@index([isActive])
  @@index([publishedById])
  @@map("clinical_library_publishes")
}

/// Patient direction configuration (zones + direction rules), versioned like the
/// clinical libraries. One active version per facility.
model RoutingConfigPublish {
  id            String   @id @default(uuid())
  facilityCode  String   @default("default") @map("facility_code")
  version       String
  isActive      Boolean  @default(false) @map("is_active")
  config        Json
  changelog     String?
  publishedAt   DateTime @default(now()) @map("published_at")
  publishedById String   @map("published_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  publishedBy User @relation(fields: [publishedById], references: [id])

  @@index([facilityCode, isActive])
  @@index([publishedById])
  @@map("routing_config_publishes")
}

/// Live zone status (busy switch). Not versioned: it changes during a shift.
model ZoneStatus {
  facilityCode   String   @default("default") @map("facility_code")
  departmentCode String   @map("department_code")
  zoneCode       String   @map("zone_code")
  busy           Boolean  @default(false)
  updatedById    String?  @map("updated_by_id")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@id([facilityCode, departmentCode, zoneCode])
  @@map("zone_status")
}

model AuditEvent {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  actorId    String   @map("actor_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_events")
}

/// A physician's check of the triage level: agreement at "Seen", or a re-triage.
/// The reference used for the nurses' private feedback (Stage A, before any HIS link).
model CtasReview {
  id             String   @id @default(uuid())
  journeyId      String   @map("journey_id")
  triageRecordId String?  @map("triage_record_id")
  nurseLevel     Int      @map("nurse_level")
  reviewedLevel  Int      @map("reviewed_level")
  agreed         Boolean
  reason         String?
  /// The patient changed after triage (deteriorated or improved): not counted for or against the nurse.
  conditionChanged Boolean @default(false) @map("condition_changed")
  reviewerId     String   @map("reviewer_id")
  reviewerRole   UserRole @map("reviewer_role")
  createdAt      DateTime @default(now()) @map("created_at")

  journey  PatientJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  reviewer User           @relation("CtasReviewer", fields: [reviewerId], references: [id])
  feedback TriageFeedback[]

  @@index([journeyId])
  @@index([triageRecordId])
  @@map("ctas_reviews")
}

/// The nurse's response to a reviewed case in "My triage": understood or disputed.
model TriageFeedback {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  nurseId   String   @map("nurse_id")
  action    String
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  review CtasReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  nurse  User       @relation(fields: [nurseId], references: [id])

  @@unique([reviewId, nurseId])
  @@map("triage_feedback")
}
