# Database — local Docker Postgres (npm run db:up). Both URLs are the same locally.
DATABASE_URL=postgresql://triagepulse:triagepulse@localhost:55432/triagepulse
DIRECT_URL=postgresql://triagepulse:triagepulse@localhost:55432/triagepulse

# Database — Supabase development project (see docs/SUPABASE.md). Synthetic data only.
# App traffic goes through the transaction pooler; migrations use the session pooler.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres

# API
# Required, at least 32 characters. Generate: openssl rand -base64 48
# The API refuses to start with a missing, short or example value.
JWT_SECRET=
JWT_EXPIRES_IN=8h
PORT=3001
CORS_ORIGIN=http://localhost:5174

# Speechmatics live speech (Arabic + English in one model, medical domain). Preferred when set.
# In a codespace, add SPEECHMATICS_API_KEY as a Codespaces secret.
SPEECHMATICS_API_KEY=
# SPEECHMATICS_RT_URL=wss://eu.rt.speechmatics.com/v2   # EU region (data residency)
# SPEECHMATICS_LANGUAGE=ar_en
# SPEECHMATICS_DOMAIN=medical        # 'none' to turn off
# SPEECHMATICS_MAX_DELAY=1.5

# OpenAI STT (optional — use only on PDPL-approved endpoints with a signed DPA)
# In a codespace, add OPENAI_API_KEY as a Codespaces secret instead of writing it here.
# Leave the rest commented: the code defaults below are the tuned bilingual settings.
OPENAI_API_KEY=
# OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
# OPENAI_REALTIME_DELAY=high          # higher = better Arabic/English switching, slightly more lag
# OPENAI_REALTIME_VAD=auto            # auto | server_vad | off
# OPENAI_REALTIME_SILENCE_MS=600      # pause before a segment is committed
# OPENAI_STT_MODEL=gpt-transcribe     # batch fallback
# OPENAI_STT_MODEL_FAST=gpt-4o-transcribe
# OPENAI_EXTRACTION_MODEL=gpt-4o

# Web
VITE_API_URL=http://localhost:3001
