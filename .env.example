# Database
DATABASE_URL=postgresql://triagepulse:triagepulse@localhost:55432/triagepulse

# API
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=8h
PORT=3001
CORS_ORIGIN=http://localhost:5173

# OpenAI STT (optional — use only on PDPL-approved in-Kingdom endpoints with DPA)
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_MODEL_FAST=gpt-4o-mini-transcribe
OPENAI_EXTRACTION_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
# GPT Voice–like streaming transcription (Realtime API, server-proxied)
# Connects to wss://api.openai.com/v1/realtime?intent=transcription
OPENAI_REALTIME_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_REALTIME_DELAY=low

# Web
VITE_API_URL=http://localhost:3001
OPENAI_REALTIME_VAD=off
